{
  "name": "pi-session-summary",
  "version": "0.2.1",
  "description": "Print session token, cache, cost, and call totals when quitting Pi's TUI.",
  "license": "MIT",
  "author": "Michael Brunner",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "keywords": ["pi-package", "pi", "sessions"],
  "files": ["index.ts", "README.md", "LICENSE"],
  "pi": { "extensions": ["./index.ts"] },
  "scripts": {
    "test": "node --test *.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.12",
      "undici": "8.12.3"
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
